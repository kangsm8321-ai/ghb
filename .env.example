# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── 텔레그램 봇 (승인 워크플로) ──
# 텔레그램 봇 토큰(API 키)과 승인받는 Chat ID. 설정 시 1·2·3단계 컨펌 흐름이 활성화됩니다.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_SECRET="subculture-mag-secret"
# TG_MODE: off | webhook | polling
TG_MODE="off"

# ── Cloud Scheduler Cron ──
CRON_SECRET="subcul-cron-secret"

# ── 매거진 설정 ──
MAG_HANDLE="@animemag.kr"
MAX_AGE_HOURS="48"
TEXT_MODEL="gemini-3.1-flash-lite"
# BRAVE_API_KEY: 선택이지만, 본문 사진의 다양성이 크게 좋아집니다.
BRAVE_API_KEY=""

# ── 인스타그램 자동 업로드 (Instagram Graph API) ──
# 인스타 프로페셔널(비즈니스) 계정 + instagram_business_content_publish 권한이 있는 토큰 필요
IG_USER_ID=""
IG_ACCESS_TOKEN=""

